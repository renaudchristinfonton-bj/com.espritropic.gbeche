{
  "expo": {
    "name": "GBECHE",
    "slug": "GBECHE",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.espritropic.gbeche",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.espritropic.gbeche",
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "GBECHE utilise Face ID pour verrouiller l'accès à tes données personnelles."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#070911",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.espritropic.gbeche",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070911",
          "dark": {
            "backgroundColor": "#070911"
          },
          "light": {
            "backgroundColor": "#070911"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GBECHE utilise Face ID pour vérifier ton identité avant d'ouvrir ton Quartier Général."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d94ea448-0d7a-49ac-af8f-6af36b7517ec"
      }
    }
  }
}
